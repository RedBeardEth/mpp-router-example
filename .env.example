# Public configuration only. No wallet key or provider API key belongs in this app.
ROUTER_ORIGIN=http://127.0.0.1:38080
# Obtain the expected Tempo payee from your router operator; required for live quotes.
ROUTER_RECIPIENT=
TEMPO_NETWORK=testnet
# Maximum per-request hold in pathUSD (testnet) or USDC.e (mainnet).
MAX_PAYMENT=0.10
